# Worker agent service, templated on the config name.
#
#   sudo cp examples/deploy/farmteam-agent@.service /etc/systemd/system/
#   sudo systemctl enable --now farmteam-agent@miner-vllm
#
# The instance name must match a config at /etc/farmteam/<name>.toml.

[Unit]
Description=farmteam agent (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOU
WorkingDirectory=/opt/farmteam
ExecStart=/usr/local/bin/uv run --directory /opt/farmteam \
    farmteam agent run -c /etc/farmteam/%i.toml
Restart=always
RestartSec=5

# The agent reconnects on its own; give it room to retry a hub that is still booting.
StartLimitIntervalSec=0

# Tools run as this user on this node. Keep the blast radius small.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/YOU/agent-scratch

[Install]
WantedBy=multi-user.target
